{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nuopen26",
  // Your personal Cloudflare account; this is separate from WHD production.
  "account_id": "fd8bf8dde3e0025c6b89a65169dead3c",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "html_handling": "none",
  },
  "vars": {
    "BETTER_AUTH_URL": "https://nuopen26.ghbit.workers.dev",
    // Blank uses the event deadline. A var, so .dev.vars can still override it (see secrets below).
    "REGISTRATION_DEADLINE": "",
    // Codeforces logins are this prefix + the table number (team07). Proctoring's login prefix
    // setting must be the same.
    "CF_LOGIN_PREFIX": "team",
    // The proctoring upload page behind the dashboard's upload button.
    "PROCTORING_URL": "",
    // ISO 8601 instant when the contest starts and the upload button appears. Blank hides it.
    // Proctoring's contest start must be the same instant.
    "CONTEST_START": "",
  },
  // A deploy fails while any of these is not set on the Worker. Local dev only warns, and loads only
  // these names and the vars above from .dev.vars. Add Google credentials here to enable Google login.
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "GAS_URL", "GAS_SECRET", "ADMIN_EMAILS"],
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nuopen26",
      "database_id": "44b554ba-28d9-47fd-972e-8212e51f7855",
      "migrations_dir": "drizzle",
    },
  ],
  // Workers AI, for the dashboard's "generate a team name" button.
  "ai": {
    "binding": "AI",
  },
}
